# API local simulado (MSW). Cambiar a "disabled" cuando el backend esté disponible.
VITE_API_MOCKING=enabled
# URL base del API Gateway. Vacío = mismo origen del frontend.
VITE_API_BASE_URL=
# Endpoint SockJS del Real-Time Gateway (solo se usa con el simulador desactivado).
VITE_REALTIME_URL=http://localhost:8083/ws
