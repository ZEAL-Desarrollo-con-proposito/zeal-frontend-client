# Copia este archivo como .env.local para sobrescribir valores sin versionarlos.

# "enabled" usa el API local simulado (MSW); "disabled" consume el backend real.
VITE_API_MOCKING=disabled
# URL base del API Gateway (ej. http://localhost:8080). Vacío = mismo origen del frontend.
VITE_API_BASE_URL=http://localhost:8080
# Endpoint SockJS del Real-Time Gateway (STOMP).
VITE_REALTIME_URL=http://localhost:8083/ws
